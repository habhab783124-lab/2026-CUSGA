      enemyPathReference: {fileID: 0}
      pathSequence: 0
  - displayName: "\u7B2C 02 \u6CE2"
    designerNote: Introduce shield support and stealth pressure while still keeping
      the total count readable.
    spawnGroups:
    - enemyType: 1
      enemyCount: 6
      spawnInterval: 0.95
      enemyPathReference: {fileID: 0}
      pathSequence: 0
    - enemyType: 3
