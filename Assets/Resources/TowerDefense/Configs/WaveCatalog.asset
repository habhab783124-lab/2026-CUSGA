      enemyPathReference: {fileID: 0}
      pathSequence: 0
    - enemyType: 2
      enemyCount: 4
      spawnInterval: 0.5
      enemyPathReference: {fileID: 0}
      pathSequence: 0
  - displayName: "\u7B2C 03 \u6CE2"
    designerNote: Mix heavy armor, repair support and one death-split boss-style
      unit.
    spawnGroups:
    - enemyType: 5
