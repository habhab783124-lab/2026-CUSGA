  m_Script: {fileID: 11500000, guid: 98cf01f2b48c4d22854a0079dc8a95bc, type: 3}
  m_Name: LevelSelectCatalog
  m_EditorClassIdentifier: 
  levels:
  - sceneName: SampleScene
    scenePath: Assets/Scenes/SampleScene.unity
    displayName: LEVEL 01
    subtitle: CURRENT TEST ROUTE
    description: The current playable sample battlefield. Use this as the base mission while the later scenes are still being authored.
    statusLabel: OPEN
    iconSprite: {fileID: 0}
    accentColor: {r: 1, g: 0.68, b: 0.36, a: 1}
    interactable: 1
  - sceneName: Level02
    scenePath: Assets/Scenes/Level02.unity
    displayName: LEVEL 02
    subtitle: SECOND FRONT
    description: A new mission scene prepared for your next map. You can open it directly in the editor and start rebuilding terrain, routes, and decoration.
    statusLabel: EDIT READY
    iconSprite: {fileID: 0}
    accentColor: {r: 0.34, g: 0.88, b: 0.96, a: 1}
    interactable: 1
  - sceneName: Level03
    scenePath: Assets/Scenes/Level03.unity
    displayName: LEVEL 03
    subtitle: OUTER GRID
    description: Reserved for the third mission layout. The gameplay skeleton is copied over so you can focus on map authoring first.
    statusLabel: EDIT READY
    iconSprite: {fileID: 0}
    accentColor: {r: 0.47, g: 0.96, b: 0.74, a: 1}
    interactable: 1
  - sceneName: Level04
    scenePath: Assets/Scenes/Level04.unity
    displayName: LEVEL 04
    subtitle: RELAY BREAK
    description: Reserved for the fourth mission layout. Treat this as another fully editable gameplay scene slot.
    statusLabel: EDIT READY
    iconSprite: {fileID: 0}
    accentColor: {r: 1, g: 0.78, b: 0.43, a: 1}
    interactable: 1
  - sceneName: Level05
    scenePath: Assets/Scenes/Level05.unity
    displayName: LEVEL 05
    subtitle: FINAL CIRCUIT
    description: Reserved for the fifth mission layout. Keep this one for your later, more advanced battlefield ideas.
    statusLabel: EDIT READY
    iconSprite: {fileID: 0}
    accentColor: {r: 1, g: 0.52, b: 0.41, a: 1}
    interactable: 1
